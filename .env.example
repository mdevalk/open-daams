POSTGRES_USER=dbuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hdab_daams

DATABASE_URL="postgresql://dbuser:changeme@localhost:5432/hdab_daams"

# Software/document brand shown in the header, page titles, and permit PDFs.
# Rebrand for your member state (e.g. "DAAMS-BE"). Defaults to DAAMS-NL if unset.
DAAMS_APP_NAME=DAAMS-NL

# National Dispatcher (NCP) API key for the HDAB-NL test environment
# (https://ap.hdab-nl.eu/national-dispatcher/). Without it, cross-border
# queue retrieval and decision-card transmission fall back to fixture data.
NCP_API_KEY=

# Keycloak container bootstrap admin (docker-compose.yml). Demo-only,
# local-only — not a production secret.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Auth.js (next-auth) — these exact names are required for its Keycloak
# provider auto-detection, do not rename.
AUTH_SECRET=
AUTH_KEYCLOAK_ID=daams-app
AUTH_KEYCLOAK_SECRET=daams-app-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/daams
AUTH_URL=http://localhost:3000
