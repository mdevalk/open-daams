generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationType {
  DATA_ACCESS_APPLICATION
  DATA_REQUEST
}

// TEHDAS2 D6.4 Section 7.6 — identical for both application types
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  PRE_SCREENING
  AWAITING_ADDITIONAL_INFORMATION
  PROCESSING
  DECISION_ISSUED
  WITHDRAWN
}

// TEHDAS2 D6.4 Section 9 — sub-state of DECISION_ISSUED
enum DecisionOutcome {
  POSITIVE
  NEGATIVE
}

// TEHDAS2 D6.4 Section 9.2 — optional step between positive decision and permit issuance
enum PermitAcceptanceStatus {
  PENDING // Conditions sent to applicant, awaiting confirmation
  ACCEPTED // Applicant confirmed — proceed to issue permit
  DECLINED // Applicant declined — application treated as withdrawn
}

// TEHDAS2 D6.3 §6.5 / EHDS Art. 62 — cost estimate sent to the applicant
// during assessment, before a decision is made
enum FeeEstimateStatus {
  PENDING // Sent to applicant, awaiting confirmation
  ACCEPTED // Applicant confirmed — assessment continues
  REJECTED // Applicant did not accept — application may be withdrawn/scoped down
}

// TEHDAS2 D6.4 Section 9.3
enum DataPermitStatus {
  GRANTED
  AMENDED
  RENEWED
  REVOKED
  EXPIRED
}

// TEHDAS2 D6.4 §9.3/§9.4 — a change requested against an already-issued permit.
// Kept DISTINCT from the permit's own status: approving a request drives a
// DataPermit status change (amended/renewed/reinstated); rejecting leaves the
// permit unchanged. The 12 v0.5 permit-status values map onto {DataPermitStatus}
// x {this request workflow}.
enum PermitChangeType {
  AMENDMENT
  RENEWAL
  REVOCATION_APPEAL
}

enum PermitChangeStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model PermitChangeRequest {
  id       String             @id @default(cuid())
  permitId String
  permit   DataPermit         @relation(fields: [permitId], references: [id])
  type     PermitChangeType
  status   PermitChangeStatus @default(REQUESTED)

  justification   String    @db.Text // provided by the data user, documented by the HDAB
  decisionComment String?   @db.Text // HDAB's decision note
  newValidUntil   DateTime? // for approved renewals

  requestedById String
  requestedBy   User     @relation("PermitChangeRequested", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  decidedById String?
  decidedBy   User?     @relation("PermitChangeDecided", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TEHDAS2 D6.3 §6.1 — ethical review referenced in the application assessment
// (required where member state law mandates it for the type of project)
enum EthicalReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// EHDS Art. 63 / national administrative law — appeal (bezwaar) and further
// judicial appeal (beroep) against a decision issued by the HDAB
enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD // Appeal successful — original decision revised
  REJECTED // Appeal rejected — original decision stands
  WITHDRAWN
}

// TEHDAS2 D6.3 §5.5 — outcome of the completeness check
enum CompletenessResult {
  PENDING
  COMPLETE
  INCOMPLETE
}

// TEHDAS2 D6.3 §7.1 / EHDS Art. 60, 68(7) — extraction request lifecycle
// between the HDAB and a health data holder
enum ExtractionStatus {
  REQUESTED
  CONFIRMED
  DELIVERED
  DECLINED
}

// TEHDAS2 D6.3 Annex 5 §6.1 — how the study cohort was/will be formed
// (data access applications only; not applicable to data requests)
enum CohortFormationMethod {
  CRITERIA // formed based on the criteria given in this application
  PREVIOUS_COHORT // an already-established cohort
  COMBINED // combination of criteria and a previously established cohort
  WHOLE_POPULATION // the whole population of the indicated country/countries
}

// TEHDAS2 D6.3 Annex 5 §6.1 / Annex 6 §6.1 — cohort/dataset extraction method
// (shared by both application types)
enum ExtractionMethod {
  RANDOM_SAMPLE
  ALL_QUALIFYING
  OTHER_SAMPLE
}

// TEHDAS2 D6.3 Annex 5 §6.1 / Annex 6 §6.1 — how often data must be extracted
enum ExtractionFrequency {
  ONCE
  MULTIPLE_TIMES
}

// TEHDAS2 D6.3 Annex 5 §6.1 / Annex 6 §6.1 — interval between recurring
// extractions, when ExtractionFrequency is MULTIPLE_TIMES
enum ExtractionInterval {
  YEARLY
  HALF_YEARLY
  QUARTERLY
  OTHER
}

// TEHDAS2 D6.3 Annex 5 §6.1-6.3 — a StudyCohort row's role within its country
// scope: the cohort itself, or one of its linked control/relative groups
enum StudyGroupRole {
  COHORT
  CONTROL
  RELATIVE
}

// TEHDAS2 D6.3 Annex 5 §8 — when the health data user needs access to start
// (data access applications only)
enum DataAccessTiming {
  AS_SOON_AS_POSSIBLE
  LATER
}

enum UserRole {
  APPLICANT
  CASE_HANDLER
  DECISION_MAKER
  DATA_HOLDER
  ADMIN
}

enum ApplicationSource {
  NATIONAL
  HDEU
}

// EHDS Art. 68 — the applicable decision deadline depends on the applicant.
// STANDARD: 3 months, extendable by 3 (general applicants).
// EXPEDITED: 2 months, extendable by 1 (public-sector bodies / Union
// institutions acting under a public-health or policy mandate).
enum DecisionTrack {
  STANDARD
  EXPEDITED
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  role       UserRole
  // Masterdata reference (Reference data / DataUser registry).
  dataUserId String
  dataUser   DataUser @relation(fields: [dataUserId], references: [id])
  createdAt  DateTime @default(now())

  applications                Application[]           @relation("Applicant")
  handledCases                Application[]           @relation("CaseHandler")
  applicationLogs              ApplicationLog[]
  notes                       Note[]
  permitActions               DataPermitLog[]
  auditLogs                   AuditLog[]
  completenessChecks          CompletenessCheck[]
  extractionRequests          DataExtractionRequest[]
  issuedInvoices              Invoice[]
  speProvisioningActions      SpeProvisioningLog[]
  permitChangeRequestsMade    PermitChangeRequest[]   @relation("PermitChangeRequested")
  permitChangeRequestsDecided PermitChangeRequest[]   @relation("PermitChangeDecided")
  ncpIntegrationLogs          NcpIntegrationLog[]
}

model Application {
  id              String            @id @default(cuid())
  referenceNumber String            @unique
  type            ApplicationType
  status          ApplicationStatus @default(DRAFT)
  source          ApplicationSource @default(NATIONAL)

  // Sub-state of DECISION_ISSUED (D6.4 §9)
  decisionOutcome DecisionOutcome?
  decisionAt      DateTime?
  decisionSummary String?          @db.Text

  // Decision card / pending acceptance (D6.4 §9.2, SHOULD). The decision
  // card itself — decisionId, decisionCardPdf and (for negative decisions)
  // its signature — is generated when DECISION_ISSUED is set; see
  // lib/permit-signing.ts and lib/generate-decision-pdf.ts.
  decisionId String? @unique // e.g. DEC-NL-2026-0001, distinct from the application/permit ID

  // Positive path: pre-permit review before real permit issuance.
  permitAcceptanceStatus   PermitAcceptanceStatus?
  permitConditionsSentAt   DateTime?
  permitAcceptanceDeadline DateTime? // permitConditionsSentAt + 28 days (R9.2.6)
  permitAcceptedAt         DateTime?

  // Negative path: signed decision document + accept/appeal.
  negativeDecisionSentAt         DateTime?
  negativeDecisionAcknowledgedAt DateTime?

  // The decision-card document itself (unsigned pre-permit PDF for a
  // positive decision, signed decision PDF for a negative one).
  decisionCardPdf          Bytes?
  decisionCardSignature    String?   @db.Text // negative decisions only — positive stays unsigned (R9.2.2)
  decisionCardSignedAt     DateTime?
  decisionCardSigningKeyId String?

  // HD@EU cross-border fields
  hdeuApplicationId  String?
  hdeuSendingCountry String?
  // The sending country's own transmission timestamp, as transmitted in the
  // payload — preserved separately from hdeuReceivedAt below (R8.0.7: due
  // dates must anchor to this national DAAMS's receipt, not the sender's).
  hdeuTransmittedAt  DateTime?
  hdeuReceivedAt     DateTime?
  hdeuRawPayload     String?   @db.Text

  applicantId String
  applicant   User   @relation("Applicant", fields: [applicantId], references: [id])

  caseHandlerId String?
  caseHandler   User?   @relation("CaseHandler", fields: [caseHandlerId], references: [id])

  // TEHDAS2 D6.4 §12 / EHDS Art. 72 — trusted data holder selected for this application
  trustedDataHolderId String?
  trustedDataHolder   DataHolder? @relation(fields: [trustedDataHolderId], references: [id])

  // TEHDAS2 D6.3 Annex 5/6 §3 — applicant/contact person detail beyond what's
  // on the User/DataUser masterdata record
  applyingOnBehalfOfPublicSector      Boolean?
  applyingForMandatedTasks            Boolean?
  legalOrNaturalPerson                String? // "Legal person" | "Natural person", as transmitted
  legalPersonAddress                  String?
  legalPersonZipCode                  String?
  legalPersonCity                     String?
  legalPersonCountry                  String?
  contactPersonJobTitle               String?
  contactPersonAffiliation            String?
  contactPersonOrganisationName       String? // distinct field from contactPersonAffiliation (Release 7 §3)
  contactPersonRelationship           String?
  contactPersonBusinessId             String?
  contactPersonOperatorID             String?
  contactPersonPhone                  String? // formatted "+<countryCode> <number>", as transmitted
  // "Profile data last confirmed" timestamps (Release 7 §3/§4/§5/§6) — low
  // case-management value, just mark when a reused profile block was synced
  legalOrNaturalPersonProfileDataDate DateTime?
  contactPersonProfileDataDate        DateTime?

  // EHDS common data access application form fields
  title                                                   String
  projectDescription                                      String    @db.Text
  purposeCategory                                         String
  // TEHDAS2 D6.3 Annex 5/6 §2 — full multi-select purpose list (Art. 53(1)(a)-(f));
  // purposeCategory above keeps the single-value simplification for backward compat
  purposeCategories                                       String[]
  projectLeaderName                                       String?
  projectLeaderCountry                                    String?
  // Release 7 §2 — research-detail fields beyond the purpose/summary above
  theResearchFocusesOnTheFollowingObjectives              String[]
  theResearchFocusesOnTheFollowingObjectivesOther         String?
  areaOfResearch                                          String?
  areaOfResearchOther                                     String?
  descriptionOfTheDataYouWillUse                          String?   @db.Text
  theNatureOfTheDataDoesNotLetYouProvideADescription      Boolean?
  // Release 7 §2 — projectDescription above keeps its existing merged-text
  // behaviour (non-nullable, fed by the manual form); these three mirror the
  // real form's own distinct fields precisely instead of a merged approximation
  descriptionOfTheProject                                 String?   @db.Text
  summaryOfTheProject                                     String?   @db.Text
  theNatureOfTheProjectDoesNotLetYouProvideASummary       Boolean?
  theNatureOfTheProjectDoesNotLetYouProvideASummaryReason String?   @db.Text
  requestedVariables                                      String    @db.Text
  studyPopulation                                         String    @db.Text
  inclusionCriteria                                       String    @db.Text
  exclusionCriteria                                       String    @db.Text
  dataStartDate                                           DateTime?
  dataEndDate                                             DateTime?
  projectStartDate                                        DateTime?
  projectEndDate                                          DateTime?
  legalBasis                                              String
  dataProcessingCountry                                   String
  isCrossBorder                                           Boolean   @default(false)

  // TEHDAS2 D6.3 Annex 5/6 §5 — purpose-of-use detail beyond legalBasis/projectDescription
  whyDataIsNeeded                      String?   @db.Text
  whatIsTheAimAndTopicOfTheProject     String?   @db.Text // distinct field per Release 7 §5 (was folded into projectDescription)
  expectedBenefits                     String?   @db.Text
  applicantQualifications              String?   @db.Text
  linkToTheSupportingLegalBasis        String?
  summaryOfPlanForUsingTheDataLanguage String?
  summaryOfResearchPlanLanguage        String?
  personResponsibleSameAsContactPerson Boolean?
  personResponsibleName                String?
  personResponsibleJobTitle            String?
  personResponsibleAffiliation         String?
  personResponsibleProfileDataDate     DateTime?
  // Release 7 §5 — a second, parallel person-block distinct from personResponsible*
  personResearchSameAsContactPerson    Boolean?
  personResearchName                   String?
  personResearchJobTitle               String?
  personResearchAffiliation            String?
  personResearchProfileDataDate        DateTime?
  electronicHealthDataFormat           String? // "Anonymised" | "Pseudonymised", as transmitted
  pseudonymisedDataJustification       String?   @db.Text
  consentCompliesWithArt6              Boolean?
  consentAssessedEthicalAspects        Boolean?

  // Cohort/dataset extraction (D6.3 Annex 5 §6.1 / Annex 6 §6.1 — shared)
  cohortSizeIsEstimate      Boolean?
  cohortSize                Int?
  cohortSizeJustification   String?              @db.Text
  extractionMethod          ExtractionMethod?
  sampleSize                String? // e.g. "100000 persons" or "50%"
  samplingMethodDescription String?              @db.Text
  extractionFrequency       ExtractionFrequency?
  extractionInterval        ExtractionInterval?
  extractionIntervalOther   String?
  extractionTimingNotes     String?              @db.Text

  // Opt-out exception mechanism (Annex 5 §8 / Annex 6 §6 — EHDS Art. 71(4))
  usesOptOutException          Boolean @default(false)
  optOutExceptionJustification String? @db.Text

  // Data access application only (Annex 5 §6.1–6.3, 7, 8) — null/unused for
  // DATA_REQUEST, where only anonymised aggregated statistics are returned
  cohortFormationMethod      CohortFormationMethod?
  dataSubjectsInformed       Boolean?
  dataSubjectsInformedDetail String?                @db.Text // "how" if informed, or "why not" if not
  includesControls           Boolean                @default(false)
  controlsDescription        String?                @db.Text
  includesRelatives          Boolean                @default(false)
  relativesDescription       String?                @db.Text
  otherDataToCombine         Boolean                @default(false)
  otherDataDescription       String?                @db.Text

  // TEHDAS2 D6.3 Annex 5 §7 — "other data to be combined" detail beyond the
  // otherDataToCombine/otherDataDescription summary above
  otherDataCountries           String[]
  otherDataHolders             String[]
  otherDataDatabases           String[]
  otherDataDatasets            String[]
  otherDataCombinationMethod   String?   @db.Text
  hasPendingPermitApplications Boolean?
  pendingApplicationDate       DateTime?
  pendingApplicationIssuer     String?
  pendingApplicationPermitCode String?

  // Release 7 §9 — free-form additional notes, no equivalent field prior to
  // this section being modelled at all
  additionalInformation String? @db.Text

  speName                                               String?
  speTechnicalRequirements                              String?           @db.Text
  dataAccessTiming                                      DataAccessTiming?
  dataAccessLaterDate                                   DateTime?
  environmentProviderName                               String? // provider of the named SPE (speName is its name)
  dataAccessPeriodInfo                                  String?           @db.Text
  dataAccessUpdateFrequency                             String?
  inactiveStoragePeriodStart                            DateTime?
  inactiveStoragePeriodEnd                              DateTime?
  transfersOutsideEuEea                                 Boolean           @default(false)
  transferCountries                                     String[]
  transferLegalBasis                                    String?           @db.Text
  // transferLegalArticle/transferSafeguards below stay as a condensed summary
  // (backward compat); the full Art. 47/48/49 tree (Release 7 §8) is modelled
  // explicitly alongside it, one field per checkbox, per the "all fields
  // explicit" decision — this citation structure is large but not boilerplate
  // DAAMS can safely collapse, since which safeguard was actually selected is
  // itself case-relevant
  transferLegalArticle                                  String? // "47" | "48" | "49", as transmitted
  transferSafeguards                                    String[] // selected safeguard mechanism codes
  whyWillDataBeTransferredOutsideEUArticle47            Boolean?
  whyWillDataBeTransferredOutsideEUArticle47Options     String[]
  whyWillDataBeTransferredOutsideEUArticle47a           Boolean?
  whyWillDataBeTransferredOutsideEUArticle47b           Boolean?
  whyWillDataBeTransferredOutsideEUArticle47c           Boolean?
  whyWillDataBeTransferredOutsideEUArticle48            Boolean?
  whyWillDataBeTransferredOutsideEUArticle48a           Boolean?
  whyWillDataBeTransferredOutsideEUArticle48b           Boolean?
  whyWillDataBeTransferredOutsideEUArticle48bOptions    String[]
  whyWillDataBeTransferredOutsideEUArticle48c           Boolean?
  whyWillDataBeTransferredOutsideEUArticle48cOpt        String?
  whyWillDataBeTransferredOutsideEUArticle48d           Boolean?
  whyWillDataBeTransferredOutsideEUArticle48e           Boolean?
  whyWillDataBeTransferredOutsideEUArticle49            Boolean?
  legalBasisForTransferringTheDataOutsideEU             String?
  legalBasisForTransferringTheDataOutsideEUOtherOptions String[]
  safeguardsAreProvidedByReferringGDCP                  String[]
  safeguardsAreProvidedByOtherExceptionalLegalBases     String?
  dataController                                        String?
  dataMinimisationCompliance                            String?           @db.Text
  complyWithDataMinimisationPrincipleNotEUMember        String?           @db.Text
  // The five fixed data-protection/security attestation checkboxes (Annex 5 §8)
  protectionStatement1                                  Boolean?
  protectionStatement2                                  Boolean?
  protectionStatement3                                  Boolean?
  protectionStatement4                                  Boolean?
  protectionStatement5                                  Boolean?
  dataProcessingPersonnel                               String[] // names/affiliations/emails of people processing the data
  // lawfulnessOfProcessing below is the GDPR Art. 6(1) selector; Release 7 §8
  // has four more distinct legal-basis selectors alongside it, one per data
  // scope, plus the EU-institution Art. 5(1) EUDPR variant
  lawfulnessOfProcessing                                String[] // selected GDPR Art. 6(1) grounds, stored as codes
  lawfulnessLegalBasisOther                             String? // free-text "Other, which?" fallback
  lawfulForProcessingPersonalData                       String[] // Art. 5(1) EUDPR variant, EU institutions
  europeanUnionInstitution                              String[]
  legalBasisForProcessingCombinedData                   String[]
  otherLegalBasisForProcessingCombinedData              String?
  legalBasisForProcessingApplicationData                String[]
  otherLegalBasisForProcessingApplicationData           String?
  legalBasisForProcessingCombinedApplicationData        String[]
  otherLegalBasisForProcessingCombinedApplicationData   String?

  // Data request only (Annex 6 §6) — the tabulation plan for compiling
  // anonymised aggregated statistics; not applicable to data access applications.
  // Kept as a flat summary for backward compat; full fidelity (Release 7 §6 —
  // the real form models this as an array) is in the TabulationPlan relation below
  tabulationPlan              String? @db.Text
  ethicalReviewInput          String? @db.Text // Data Request §6 — distinct from ethicalReviewAttachment
  whatIsTheFrequencyOfUpdates String?

  // TEHDAS2 D6.3 Annex 5/6 §10 — confirmation checkboxes required to submit
  consentAwareProcessingFee       Boolean?
  consentAwareChargeFee           Boolean?
  consentAwareInformationCorrect  Boolean?
  consentNoAccessToUnderlyingData Boolean? // Annex 6 (DATA_REQUEST) only
  consentAcceptHealthDataBody     Boolean? // Release 7 Table 47 "acceptHealthDataBody" (DATA_REQUEST only)

  // Ethical review (D6.3 §6.1, required where member state law mandates it)
  ethicalReviewRequired  Boolean              @default(false)
  ethicalReviewStatus    EthicalReviewStatus?
  ethicalReviewBody      String? // name of the ethics committee/IRB
  ethicalReviewReference String? // approval reference/case number
  ethicalReviewDate      DateTime?

  // Statutory deadlines
  // D6.4 §8: voided when AWAITING_ADDITIONAL_INFORMATION, recalculated on return to PROCESSING
  submittedAt              DateTime?
  decisionTrack            DecisionTrack @default(STANDARD)
  decisionDeadline         DateTime?
  deadlineExtended         Boolean       @default(false)
  deadlineExtensionReason  String?       @db.Text // R8.0.8 — required justification, set together with deadlineExtended
  additionalInfoDeadline   DateTime? // Applicant response window
  additionalInfoReceivedAt DateTime? // Recalculation anchor (D6.4 §8)

  // Public disclosure (Art. 57(1)(j)(ii), 58, 61(4), D6.3 §5.1/§7.11)
  publishedAt         DateTime? // application made public, without undue delay after reception
  decisionPublishedAt DateTime? // decision/permit made public (within 30 working days)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs               ApplicationLog[]
  notes              Note[]
  documents          Document[]
  dataPermits        DataPermit[]
  feeEstimate        FeeEstimate?
  appeals            Appeal[]
  completenessCheck  CompletenessCheck?
  extractionRequests DataExtractionRequest[]
  invoices           Invoice[]
  requestedDatasets  RequestedDataset[]
  datasetVariables   DatasetVariable[]
  studyCohorts       StudyCohort[]
  invoicingDetails   ApplicantInvoicingDetails?
  attachments        Attachment[]
  relatedDataPermits RelatedDataPermit[]
  tabulationPlans    TabulationPlan[]
  lineItems          FinancialLineItem[]
  ncpIntegrationLogs NcpIntegrationLog[]

  @@index([status])
  @@index([decisionDeadline])
  @@index([additionalInfoDeadline])
  @@index([permitAcceptanceDeadline])
}

// TEHDAS2 D6.3 Annex 5 §6.1-6.3 — one row per country x role (cohort, its
// controls, its relatives). CONTROL/RELATIVE rows link back to their COHORT
// row via relatesToId. Existing flat cohort-shaped columns on Application
// stay in use by manual creation; the first COHORT row (per country) is
// mirrored into them for NCP-sourced applications too.
model StudyCohort {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  countryId String
  role      StudyGroupRole @default(COHORT)

  // Section 6 "base" fields (not 6.1/6.2/6.3-specific) — country-scoped, so
  // kept on the COHORT row, the one guaranteed-present row per country
  hdabContacts          String?   @db.Text
  howWillDataBeLinked   String?   @db.Text
  personProfileDataDate DateTime?

  relatesToId   String?
  relatesTo     StudyCohort?  @relation("StudyCohortRelation", fields: [relatesToId], references: [id])
  relatedGroups StudyCohort[] @relation("StudyCohortRelation")

  relationshipToSubject String? // RELATIVE only, e.g. "grandparent", "biological parent"

  cohortFormationMethod                                            CohortFormationMethod? // COHORT only
  // Release 7 §6 — consent/permit basis for the cohort (COHORT only)
  hasTheStudyCohortBeenFormedBasedOnInformationOfStudyParticipants Boolean?
  doesTheInformedConsentCoverTheRequestedRegistryExtractions       Boolean?
  confirmThatDataPermitHasBeenGrantedForTheResearchProject         Boolean?
  howTheStudyCohortWasObtained                                     String?                @db.Text
  detailsOfHowTheStudyCohortHasBeenFormed                          String?                @db.Text
  whyNeedDataOfaWholePopulation                                    String?                @db.Text // justification when cohortFormationMethod = WHOLE_POPULATION
  regionsSeekForData                                               String?
  informationProviderName                                          String?
  informationProviderEmail                                         String?
  informationProviderPhone                                         String?
  informationProviderSameAsContactPerson                           Boolean?
  formedFromPriorPermit                                            Boolean?
  priorPermitIssuer                                                String?
  priorPermitDate                                                  DateTime?
  priorPermitValidFrom                                             DateTime?
  priorPermitValidTo                                               DateTime?
  priorPermitNumber                                                String?

  size              Int?
  sizeIsEstimate    Boolean?
  sizeJustification String?  @db.Text

  // Relocated from Application (Release 7 §6 scopes these per country, not
  // application-wide) — Application keeps mirroring the first COHORT row's
  // values into its own flat columns of the same name, for backward compat
  dataSubjectsInformed       Boolean?
  dataSubjectsInformedDetail String?  @db.Text
  includesControls           Boolean? // COHORT only: will controls be extracted for this cohort
  controlsDescription        String?  @db.Text
  includesRelatives          Boolean? // COHORT only: will relatives be extracted for this cohort
  relativesDescription       String?  @db.Text

  sameAsCohortData       Boolean? // CONTROL/RELATIVE: reuse the cohort's holder/variables/period?
  dataHolderIds          String[]
  databaseIds            String[] // CONTROL/RELATIVE: "databasesForControls[]"/"databasesForRelatives[]"
  datasetIds             String[] // CONTROL/RELATIVE: "datasetsForControls[]"/"datasetsForRelatives[]"
  variablesAttachmentRef String? // bare filename, as transmitted — not unique alone
  variablesAttachmentId  String? // NCP attachment id; real archive entries are named "<id>_<filename>"
  timePeriod             String? // free text, as transmitted
  dataStartDate          DateTime?
  dataEndDate            DateTime?

  extractionMethod          ExtractionMethod?
  sampleSize                String?
  samplingMethodDescription String?           @db.Text
  inclusionCriteria         String?           @db.Text
  exclusionCriteria         String?           @db.Text
  matchingCriteria          String?           @db.Text // CONTROL only
  controlsPerCohortPerson   String? // CONTROL only

  willDataBeExtractedSimultaneously Boolean? // CONTROL/RELATIVE: same timing as the cohort?
  extractionFrequency               ExtractionFrequency?
  extractionInterval                ExtractionInterval?
  extractionIntervalOther           String?
  extractionTimingNotes             String?              @db.Text
  orderForExtraction                String?              @db.Text

  createdAt DateTime @default(now())
}

// TEHDAS2 D6.3 Annex 5/6 §4 — the applicant's own billing details, as
// submitted on the form. Distinct from Invoice/FeeEstimate, which are
// HDAB-generated billing documents.
model ApplicantInvoicingDetails {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sameAsContactPerson         Boolean?
  fullName                    String?
  email                       String?
  phone                       String?
  organisationName            String?
  address                     String?   @db.Text
  businessId                  String?
  vatNumber                   String?
  invoiceType                 String? // "Paper" | "Electronic", as transmitted
  invoiceReferenceNumber      String?
  eInvoiceAddress             String? // EDI or IBAN
  operatorId                  String?
  peppolCode                  String?
  isProjectFinanciallyCovered Boolean?
  financingAmountRange        String? // the a-f bracket, as transmitted
  section4ProfileDataDate     DateTime?

  createdAt DateTime @default(now())
}

// Structured reference to a file supplied with the form (research plan,
// variable list, consent letter, prior permit, etc.). Bytes are extracted
// from the NCP detail archive and persisted here at import time — the NCP
// is a message gateway, not a store, so nothing after import depends on it
// still being able to serve the application.
model Attachment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Set for correspondence/documentation attached to a specific appeal
  // (R10.0.5) — applicationId above stays set too (the appeal's own
  // application), so "everything for this application" queries still work
  // regardless of which owner this row belongs to, same pattern as
  // FinancialLineItem.applicationId.
  appealId String?
  appeal   Appeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)

  field       String // which form field this supports, e.g. "section5.summaryOfPlanForUsingTheData"
  filename    String
  sizeBytes   Int?
  description String? // NCP-issued attachment id, e.g. "6a70b820164b1a3858b83f06"
  content     Bytes
  mimeType    String?

  createdAt DateTime @default(now())
}

// TEHDAS2 D6.3 Ch. 5 / Annex 7-8 — structured completeness check preceding
// the substantive assessment (distinct from the assessment itself)
model CompletenessCheck {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  // [{ key: string, label: string, passed: boolean, comment?: string }]
  items   Json
  result  CompletenessResult @default(PENDING)
  remarks String?            @db.Text

  checkedById String?
  checkedBy   User?     @relation(fields: [checkedById], references: [id])
  checkedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A dataset requested from a specific data holder, as declared on the
// application. Can change while the application is still being processed
// (e.g. after a request for more information) — see GrantedDataset for the
// fixed, per-permit-version equivalent that's copied from this at issuance.
model RequestedDataset {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Masterdata reference (Reference data / DataHolder registry).
  dataHolderId  String
  dataHolder    DataHolder  @relation(fields: [dataHolderId], references: [id])
  name          String
  url           String?
  // EU Dataset Catalogue identifiers (HD@EU/NCP wire: dataset_id, catalog_id)
  // — traceability references, not foreign keys into a local catalogue table
  // (open-daams doesn't own the catalogue, see CLAUDE.md's scope note).
  // Carried forward onto GrantedDataset at issuance, same as name/url.
  datasetId     String?
  catalogId     String?
  // Array of { distributionId: string, title: string | null } — the wire
  // format's distributions[] for this dataset. Stored as-is; not modelled as
  // a child table since nothing here queries or filters on it.
  distributions Json?
  createdAt     DateTime    @default(now())
}

// TEHDAS2 D6.3 Annex 5/6 §1 — the applicant's own selection of variables to
// be extracted, one row per variable. Distinct from RequestedDataset (the
// dataset/register selection itself) and from Application.requestedVariables
// (a flat summary string sourced from the EU Dataset Catalogue's own variable
// list, `datasets[].variables` — a different, catalogue-side part of the
// payload). `sourceDatasetId` is the wire-format dataset id this variable
// belongs to — a traceability reference, not a foreign key into
// RequestedDataset (which uses DAAMS's own DataHolder-scoped ids).
model DatasetVariable {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sourceDatasetId String
  name            String
  title           String?
  description     String? @db.Text
  datatype        String?
  propertyUrl     String?

  createdAt DateTime @default(now())
}

// Release 7 §7 — otherDataPermits[]: prior data permits the applicant cites
// when combining this application's data with data already covered by
// another permit. One row per cited permit, distinct from DataPermit (the
// permits DAAMS itself issues) and from StudyCohort's own priorPermit*
// fields (which cover the cohort's own formation basis, not combined data).
model RelatedDataPermit {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  permitIssuer                    String?
  permitStartDateOfIssue          String? // free text, as transmitted
  permitEndDateOfIssue            String?
  permitIdentificationInformation String?

  createdAt DateTime @default(now())
}

// Release 7 Data Request §6 — tabulationPlanArray: a data request models its
// tabulation plan as an array of structured entries, not the single flat
// Application.tabulationPlan text field (kept for backward compat).
model TabulationPlan {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  tabulationRegisteredToBeUsed             String? @db.Text
  tabulationPossibleStudyCohort            String? @db.Text
  tabulationInformationOfRequiredVariables String? @db.Text
  tabulationFormationVariables             String? @db.Text
  tabulationDesiredDirection               String? @db.Text
  tabulationOrderInWhichTable              String? @db.Text
  tabulationAnyOtherRelevant               String? @db.Text
  // tabulationPlan itself (the attachment) is captured via the Attachment
  // model, tagged field = "tabulationPlan[<index>].tabulationPlan"

  createdAt DateTime @default(now())
}

// TEHDAS2 D6.3 §7.1 / EHDS Art. 60, 68(7) — request to a health data holder
// to extract the data covered by an issued permit, through to delivery
model DataExtractionRequest {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  // Masterdata reference (Reference data / DataHolder registry).
  dataHolderId       String
  dataHolder         DataHolder @relation(fields: [dataHolderId], references: [id])
  datasetDescription String     @db.Text

  requestedAt   DateTime @default(now())
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])

  status        ExtractionStatus @default(REQUESTED)
  deliveredAt   DateTime?
  deliveryNotes String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// EHDS Art. 63 / national administrative law — tracks bezwaar (objection) and
// beroep (judicial appeal) lodged against a decision issued on this
// application (or its permit, e.g. a revocation)
model Appeal {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  submittedAt DateTime @default(now())
  submittedBy String // name of the appellant (may differ from the applicant)
  grounds     String   @db.Text
  authority   String? // body handling the appeal, e.g. "HDAB-NL (bezwaar)" or "Rechtbank Den Haag"

  status          AppealStatus @default(SUBMITTED)
  decisionAt      DateTime?
  decisionSummary String?      @db.Text

  // The formal, signed decision on this appeal (R10.0.6) — set together,
  // once, when the appeal reaches a terminal decision (UPHELD/REJECTED;
  // WITHDRAWN isn't a decision on the merits, stays unsigned). Same
  // signature/pdf field shape as DataPermit, no "decision"-prefixed naming
  // needed on a model this small and single-purpose.
  signature    String?   @db.Text
  signedAt     DateTime?
  signingKeyId String?
  pdf          Bytes?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TEHDAS2 D6.3 §6.5 — cost estimate for data holder + HDAB processing fees,
// sent to the applicant for confirmation before assessment continues
// (EHDS Art. 62(5))
model FeeEstimate {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  currency      String      @default("EUR")

  // Cost breakdown — see FinancialLineItem. totalAmount is a stored cache,
  // recomputed server-side as sum(lineItems.amount) on every write.
  lineItems   FinancialLineItem[]
  totalAmount Decimal             @db.Decimal(10, 2)

  // SPE operator/type chosen upfront so the applicant's accepted cost
  // estimate already reflects real SPE costs, carried forward unchanged into
  // the permit at issuance (DataPermit.speOperatorId/speTypeId) — see
  // PermitPanel. No frozen name snapshot here (unlike DataPermit): this row
  // isn't a signed legal document, a live relation is fine.
  speOperatorId String?
  speOperator   SpeOperator? @relation(fields: [speOperatorId], references: [id])
  speTypeId     String?
  speType       SpeType?     @relation(fields: [speTypeId], references: [id])

  notes  String?           @db.Text
  status FeeEstimateStatus @default(PENDING)

  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice?
}

// TEHDAS2 D6.4 Section 9.3 — permit lifecycle, separate from application
model DataPermit {
  id            String           @id @default(cuid())
  // Base permit id, STABLE across versions (e.g. DP-NL-2025-0001); the full
  // permit id is permitNumber + version (D6.4 R9.3.8, shown as "…-v2").
  permitNumber  String
  version       Int              @default(1)
  // Exactly one version per application is the current/active one.
  isCurrent     Boolean          @default(true)
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id])
  status        DataPermitStatus @default(GRANTED)

  validFrom  DateTime
  validUntil DateTime

  // Version chain (D6.4 §9.3): an amendment/renewal/revocation appeal issues a
  // NEW version row that supersedes its predecessor, rather than mutating this
  // row in place. Linear chain — a permit has at most one predecessor/successor.
  previousPermitId String?     @unique
  previousPermit   DataPermit? @relation("PermitVersions", fields: [previousPermitId], references: [id])
  nextPermit       DataPermit? @relation("PermitVersions")

  // D6.4 R9.3.9: an amendment MAY have a delayed effective date (transition
  // period to reconfigure the SPE) instead of applying immediately. Both null
  // for the immediate path (the default, and always the case for renewals and
  // revocation appeals) — effectiveAt alone can't distinguish "not yet
  // activated" from "activated, later superseded," hence activatedAt too.
  effectiveAt DateTime?
  activatedAt DateTime?

  revocationReason String?   @db.Text
  revocationAt     DateTime?

  // Fees for data permit and processing services (Annex 9 §7 / EHDS Art. 62)
  // — see FinancialLineItem. These are a frozen copy of the accepted
  // FeeEstimate's line items, taken at issuance (D6.4 §9: no re-entry, the
  // estimate is the sole source of financial terms) and carried forward
  // unchanged on amendment/renewal/revocation-appeal, same as speOperatorId
  // etc. below.
  currency    String   @default("EUR")
  lineItems   FinancialLineItem[]
  totalAmount Decimal? @db.Decimal(10, 2)

  // SPE operator selected by the HDAB for this permit version (issuance, or
  // changed on an amendment) — carried forward unchanged on renewal/revocation-
  // appeal approval, same as the fee fields above. This live FK is for
  // staff-facing display and eventually calling the provider's provisioning
  // API — it always reflects the operator's *current* reference-data record.
  speOperatorId String?
  speOperator   SpeOperator? @relation(fields: [speOperatorId], references: [id])

  // The specific tier/type offered by the selected operator, if any — its
  // setupFee/monthlyFee become this permit's SPE_SETUP/SPE_USAGE line items
  // (see FinancialLineItem) at issuance, and the choice itself is recorded
  // here for the same audit reason as speOperatorId. Carried forward the
  // same way on renewal/revocation-appeal.
  speTypeId String?
  speType   SpeType? @relation(fields: [speTypeId], references: [id])

  // Frozen snapshot of the above, taken at the moment this permit version
  // was signed — same rationale as GrantedDataset.dataHolderName: this is
  // what's actually inside the signed digital-permit payload (R13.0.1), so
  // it must never change even if the operator/type is later renamed in the
  // reference-data registry (which would otherwise silently break signature
  // verification for every permit that already referenced it). See
  // src/lib/permit-signing.ts's SignableSpeOperator/SignableSpeType.
  speOperatorName         String?
  speOperatorProviderName String?
  speTypeName             String?

  // Frozen snapshot of the application's purpose/data-format at issuance —
  // same rationale as speOperatorName above (D6.4 R7.3.2/R7.4.2: the
  // decision's structured elements, for future reporting/publication under
  // Art. 58(1)/57(1)(j), must be part of the signed document, not a live
  // join to a record that could later change).
  purposeCategory            String?
  purposeCategories          String[]
  electronicHealthDataFormat String?

  issuedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Digital signature (Ed25519) over this version's canonical, fixed fields —
  // permitNumber, version, applicationId, issuedAt, validFrom, validUntil.
  // Deliberately excludes status/revocation: those mutate in place on this
  // same row (REVOKE/EXPIRE), so signing them would invalidate the signature
  // the moment a permit is legitimately revoked or expires. See lib/permit-signing.ts.
  signature    String?   @db.Text
  signedAt     DateTime?
  signingKeyId String?

  // The rendered, persisted PDF — the official legal document. Regenerated
  // and overwritten on every mutation that affects its content: issuance,
  // authorized-person add/remove, revoke/expire, and each new version issued
  // on amendment/renewal/revocation-appeal approval. See lib/permit-pdf-store.ts.
  pdf Bytes?

  logs              DataPermitLog[]
  authorizedPersons AuthorizedPerson[]
  invoices          Invoice[]
  speProvisioning   SpeProvisioningOrder?
  changeRequests    PermitChangeRequest[]
  grantedDatasets   GrantedDataset[]

  @@unique([permitNumber, version])
  @@index([validUntil])
  @@index([effectiveAt])
}

// EHDS Art. 73 / TEHDAS2 D6.4 §13 — provisioning of the secure processing
// environment (SPE) that authorized persons process the granted dataset in.
// Only applicable to DATA_ACCESS_APPLICATION permits (data requests return
// aggregated output and don't involve an SPE).
enum SpeProvisioningStatus {
  REQUESTED // Provisioning requested from the SPE operator
  PROVISIONING // Environment being set up
  ACTIVE // Environment provisioned and in use
  DECOMMISSIONING // Decommission requested (e.g. permit revoked/expired)
  DECOMMISSIONED
}

model SpeProvisioningOrder {
  id       String                @id @default(cuid())
  permitId String                @unique
  permit   DataPermit            @relation(fields: [permitId], references: [id])
  status   SpeProvisioningStatus @default(REQUESTED)

  // Reference/URL into the actual SPE operator's system, once known
  environmentReference String?

  // Masterdata reference (Reference data / SpeOperator registry) — who the
  // HDAB deals with operationally for this environment.
  speOperatorId String?
  speOperator   SpeOperator? @relation(fields: [speOperatorId], references: [id])

  requestedAt      DateTime  @default(now())
  provisionedAt    DateTime?
  decommissionedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs SpeProvisioningLog[]
}

model SpeProvisioningLog {
  id         String                 @id @default(cuid())
  orderId    String
  order      SpeProvisioningOrder   @relation(fields: [orderId], references: [id])
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  fromStatus SpeProvisioningStatus?
  toStatus   SpeProvisioningStatus
  comment    String?                @db.Text
  createdAt  DateTime               @default(now())
}

// EHDS Art. 62 / TEHDAS2 D6.3 Ch. 8 — invoicing of fees.
//
// A provisional invoice may be issued from an accepted FeeEstimate while the
// application is still under assessment (no permit exists yet); its line
// items are a snapshot of the estimate's fee breakdown. Once a permit is
// granted, a final (non-provisional) invoice is issued from the permit's own
// fee breakdown, which may differ (e.g. SPE fees only apply once granted).
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

// Who the invoice bills. APPLICANT is the total-cost invoice sent to the
// applicant (unchanged, all categories) — DATA_HOLDER/SPE_OPERATOR are
// self-billing invoices HDAB issues on their behalf for their own cost share
// (DATA_HOLDER / SPE_SETUP+SPE_USAGE category line items respectively). These
// are additional accounting, not a subset carved out of the applicant total.
enum InvoiceRecipientType {
  APPLICANT
  DATA_HOLDER
  SPE_OPERATOR
}

model Invoice {
  id            String               @id @default(cuid())
  invoiceNumber String               @unique // e.g. INV-NL-2026-0001 / SBI-NL-2026-0001
  provisional   Boolean              @default(false)
  recipientType InvoiceRecipientType @default(APPLICANT)
  // Frozen at issuance for DATA_HOLDER/SPE_OPERATOR invoices, same rationale
  // as GrantedDataset.dataHolderName — must never retroactively change if the
  // data holder/operator is later renamed in the reference-data registry.
  recipientName String?

  // Set once a permit exists (final invoice)
  permitId String?
  permit   DataPermit? @relation(fields: [permitId], references: [id])

  // Set for a provisional invoice, issued directly from the accepted
  // fee estimate before a permit exists
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  feeEstimateId String?      @unique
  feeEstimate   FeeEstimate? @relation(fields: [feeEstimateId], references: [id])

  // Set only for DATA_HOLDER/SPE_OPERATOR self-billing invoices — live FK,
  // informational only, same as GrantedDataset.dataHolderId (recipientName
  // above is what's authoritative once issued).
  dataHolderId String?
  dataHolder   DataHolder?  @relation(fields: [dataHolderId], references: [id])
  speOperatorId String?
  speOperator   SpeOperator? @relation(fields: [speOperatorId], references: [id])

  currency    String              @default("EUR")
  lineItems   FinancialLineItem[]
  totalAmount Decimal             @db.Decimal(10, 2)
  status      InvoiceStatus       @default(ISSUED)

  issuedAt DateTime  @default(now())
  dueAt    DateTime
  paidAt   DateTime?

  notes String? @db.Text

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueAt])
}

// A single cost breakdown line — the one shared model behind Kostenraming
// (FeeEstimate), an issued permit's fees (DataPermit), and an invoice
// (Invoice), replacing what used to be three independently hand-rolled field
// lists (see src/lib/financial-line-items.ts). Owned by exactly one of the
// three via whichever *Id is set — enforced in application code, same
// pattern Invoice already used for its own optional owner FKs.
enum FinancialLineCategory {
  ADMINISTRATIVE
  DATA_PREPARATION
  DATA_HOLDER
  SPE_SETUP
  SPE_USAGE
  ADDITIONAL_SERVICES
}

model FinancialLineItem {
  id          String                @id @default(cuid())
  category    FinancialLineCategory
  glCode      String?
  description String?               @db.Text
  amount      Decimal               @db.Decimal(10, 2)
  currency    String                @default("EUR")

  // Direct link to the application this cost belongs to, independent of
  // which record (FeeEstimate/DataPermit/Invoice) currently owns this
  // snapshot copy — lets "everything ever costed for this application" be
  // queried without joining through whichever owner happens to be set.
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Set only on DATA_HOLDER-category rows, to say which data holder this
  // cost belongs to (a permit can have more than one) — live FK,
  // informational only, same as GrantedDataset.dataHolderId.
  dataHolderId String?
  dataHolder   DataHolder? @relation(fields: [dataHolderId], references: [id])

  feeEstimateId String?
  feeEstimate   FeeEstimate? @relation(fields: [feeEstimateId], references: [id], onDelete: Cascade)
  dataPermitId  String?
  dataPermit    DataPermit?  @relation(fields: [dataPermitId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([dataHolderId])
  @@index([feeEstimateId])
  @@index([dataPermitId])
  @@index([invoiceId])
}

// Annex 9 §6.8 — persons entitled to process the data granted under this
// permit within the secure processing environment (SPE)
model AuthorizedPerson {
  id          String     @id @default(cuid())
  permitId    String
  permit      DataPermit @relation(fields: [permitId], references: [id])
  name        String
  affiliation String
  email       String
  addedAt     DateTime   @default(now())
}

// A dataset granted from a specific data holder, fixed for the life of this
// permit version — copied from the application's RequestedDataset rows at
// issuance, and carried forward unchanged to each new version on
// amendment/renewal/revocation-appeal approval (same stability model as
// AuthorizedPerson above). This is what gets signed into the digital permit
// — see lib/permit-signing.ts.
model GrantedDataset {
  id             String      @id @default(cuid())
  permitId       String
  permit         DataPermit  @relation(fields: [permitId], references: [id], onDelete: Cascade)
  // Frozen at issuance, like name/url below — feeds the Ed25519-signed permit
  // payload (permit-signing.ts), so this NEVER changes shape or gets dropped.
  dataHolderName String
  // Informational-only traceability back to the registry, copied from the
  // source RequestedDataset at issuance. Permanently nullable — never
  // authoritative for what the signature attests to.
  dataHolderId   String?
  dataHolder     DataHolder? @relation(fields: [dataHolderId], references: [id])
  name           String
  url            String?
  // Frozen at issuance, like dataHolderName/name/url above — EU Dataset
  // Catalogue identifiers (dataset_id/catalog_id) and the wire format's
  // distributions[] ({ distributionId, title }), also fed into the signed
  // permit payload. See RequestedDataset's identical fields for the source.
  datasetId      String?
  catalogId      String?
  distributions  Json?
  createdAt      DateTime    @default(now())
}

// Immutable audit log for the permit lifecycle
model DataPermitLog {
  id         String            @id @default(cuid())
  permitId   String
  permit     DataPermit        @relation(fields: [permitId], references: [id])
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  fromStatus DataPermitStatus?
  toStatus   DataPermitStatus
  action     String
  comment    String?           @db.Text
  createdAt  DateTime          @default(now())
}

model ApplicationLog {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id])
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  action        String
  comment       String?            @db.Text
  createdAt     DateTime           @default(now())
}

// General-purpose audit trail (D6.4 R15.4). The rule: ApplicationLog/
// DataPermitLog/SpeProvisioningLog are reserved for status transitions only
// (fromStatus/toStatus are real enum columns, never fabricated) — everything
// else lands here instead, whether or not it's scoped to a specific
// Application/DataPermit. Covers reference-data (masterdata) CRUD and
// non-transition case-workflow events (authorized persons, appeals,
// invoices, trusted-data-holder). Deliberately no live FK to the audited
// entity: it must keep recording "X was deleted by Y" after X is gone,
// which a cascading or SetNull FK would break or make useless.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
}

// Records a rejected requireRole/requireRoleOrOwner/findActingUser call (see
// src/lib/authz.ts) — the counterpart to the success-only logs above
// (ApplicationLog etc.), closing the OWASP A09 "only successful actions are
// logged" gap. attemptedUserId is deliberately NOT an FK: the whole point is
// capturing attempts where the supplied id doesn't correspond to any real
// user, so it can't be constrained to reference one.
model AuthzFailureLog {
  id              String   @id @default(cuid())
  attemptedUserId String?
  reason          String // "missing_user_id" | "unknown_user" | "role_not_permitted"
  detail          String   @db.Text
  createdAt       DateTime @default(now())
}

// Who initiated the HTTP connection, not which way the business data flows —
// DAAMS MUST NOT be called into by the Central Platform/NCP (D6.4 R14.0.1),
// so every call DAAMS itself makes (fetching the queue, fetching a detail
// ZIP, sending a decision card) is OUTBOUND even though a GET "fetches"
// data. INBOUND is reserved for a hypothetical future callback/webhook the
// NCP calls into — nothing populates it today.
enum NcpCallDirection {
  INBOUND
  OUTBOUND
}

enum NcpCallOutcome {
  SUCCESS
  FAILURE
}

// Records every real call to the HealthData@EU National Contact Point (see
// src/lib/ncp-client.ts) — success or failure — closing the "no logging of
// failed exchanges" gap (D6.4 R14.0.4). Doesn't fit AuditLog's entity-centric
// shape (a queue-list fetch, or a failed detail-fetch, has no local entity
// yet), same reasoning that already split out AuthzFailureLog above.
// Every operation today (queue fetch, detail fetch) is OUTBOUND; sending a
// decision card (sendDecisionCardToNcp, currently unwired) will be too, once
// it's wired up — this table's shape doesn't need to change for that.
model NcpIntegrationLog {
  id        String           @id @default(cuid())
  direction NcpCallDirection
  // Short stable label, e.g. "applications.list", "applications.detail".
  operation    String
  outcome      NcpCallOutcome
  errorMessage String?        @db.Text

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  initiatedById String?
  initiatedBy   User?    @relation(fields: [initiatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  content       String      @db.Text
  isInternal    Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  filename      String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime    @default(now())
  description   String?
}

// Reference data / masterdata registries, maintained via /reference-data
// (ADMIN-only create/edit/delete, visible to everyone). Same minimal shape
// across all four — name is the natural business key (unique), used for
// find-or-create matching during backfill and HD@EU import.

model DataHolder {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  // TEHDAS2 D6.4 §12 / EHDS Art. 72 trusted data holder — eligible for
  // referral/selection on an application.
  isTrusted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedDatasets      RequestedDataset[]
  grantedDatasets        GrantedDataset[]
  extractionRequests     DataExtractionRequest[]
  trustedForApplications Application[]
  lineItems              FinancialLineItem[]
  invoices               Invoice[]
}

// The party actually providing/hosting the SPE technology. Distinct from
// SpeOperator (the party that operates a given SPE instance under a permit
// and holds the contract with a Provider).
model SpeProvider {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operators SpeOperator[]
}

model SpeOperator {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  speProviderId String?
  speProvider   SpeProvider? @relation(fields: [speProviderId], references: [id])

  provisioningOrders SpeProvisioningOrder[]
  permits            DataPermit[]
  feeEstimates       FeeEstimate[]
  types              SpeType[]
  invoices           Invoice[]
}

// A tier/product an SPE operator offers (e.g. "Standard", "High-security"),
// each with its own setup and recurring cost — selected per permit (see
// DataPermit.speType) to pre-fill that permit's SPE fee fields.
model SpeType {
  id            String      @id @default(cuid())
  speOperatorId String
  speOperator   SpeOperator @relation(fields: [speOperatorId], references: [id], onDelete: Cascade)
  name          String
  setupFee      Decimal     @db.Decimal(10, 2)
  monthlyFee    Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  permits      DataPermit[]
  feeEstimates FeeEstimate[]

  @@unique([speOperatorId, name])
}

// The "data user" per EHDS Art. 61 — the organisation an applicant/case
// handler/decision maker belongs to.
model DataUser {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}
